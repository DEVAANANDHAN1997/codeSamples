	<!-- JDBC user repository and authentication -->
		
	
		 <security:jdbc-user-service id="jdbcUserService"
									data-source-ref="dataSource" 
									users-by-username-query="select username, password, enabled from new_users where username=?" 
									authorities-by-username-query="SELECT new_user_roles.username, new_roles.role FROM new_user_roles INNER JOIN new_roles ON 
									new_roles.roleid=new_user_roles .role_id where new_user_roles.username =?"/>		

		<security:authentication-manager>
			<security:authentication-provider user-service-ref="jdbcUserService"/>
		</security:authentication-manager>
		

		<!-- authorization configurations -->
		
		<security:http pattern="/favicon.ico" security="none"/>
		<security:http pattern="/static/*" security="none"/>
		
